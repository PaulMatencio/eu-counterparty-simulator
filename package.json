{
  "name": "eu-counterparty-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "TEST-ONLY simulator of EU regulated counterparties (MiCA CASP: KYC/AML, Travel Rule, attestation signing and revocation) for Midnight dApp end-to-end tests. Synthetic data only. Not a compliance product.",
  "type": "module",
  "imports": {
    "#kyc-harness": "./compact/managed/kyc-harness/contract/index.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "casp-sim": "dist/src/cli.js"
  },
  "scripts": {
    "compile:compact": "compact compile +0.31.1 --skip-zk compact/kyc-harness.compact compact/managed/kyc-harness",
    "check:module": "node scripts/check-module-hash.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run check:module && npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js serve",
    "web:dev": "npm --workspace apps/web run dev",
    "web:build": "npm --workspace apps/web run build",
    "web:test": "npm --workspace apps/web run test"
  },
  "workspaces": [
    "apps/web"
  ],
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
